    <diagram id="scaling-compare" name="BE vs CN 확장 비교">
        <mxGraphModel dx="1086" dy="524" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="scTitle" value="가로 확장(Scale-Out) 비교 — 핵심 차이는 &quot;가능/불가능&quot;이 아니라 &quot;데이터 재분배 비용&quot;" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="125" y="20" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="scBePanel" value="BE (Shared-Nothing) — 가로 확장 ✅ 되지만 무겁다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1;container=1;collapsible=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="560" height="480" as="geometry"/>
                </mxCell>
                <mxCell id="scBe1" value="BE 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;fontStyle=1;container=1;collapsible=0;" parent="scBePanel" vertex="1">
                    <mxGeometry x="30" y="60" width="150" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="scBeDisk1" value="로컬 디스크&lt;br&gt;Tablet 1~50" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="scBe1" vertex="1">
                    <mxGeometry x="20" y="45" width="110" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="scBe2" value="BE 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;fontStyle=1;container=1;collapsible=0;" parent="scBePanel" vertex="1">
                    <mxGeometry x="210" y="60" width="150" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="scBeDisk2" value="로컬 디스크&lt;br&gt;Tablet 51~100" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="scBe2" vertex="1">
                    <mxGeometry x="20" y="45" width="110" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="scBe3" value="BE 3 (신규 추가)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;fontStyle=1;container=1;collapsible=0;dashed=1;" parent="scBePanel" vertex="1">
                    <mxGeometry x="390" y="60" width="150" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="scBeDisk3" value="로컬 디스크&lt;br&gt;(비어 있음 → 채워야 함)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;dashed=1;" parent="scBe3" vertex="1">
                    <mxGeometry x="20" y="45" width="110" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="scBeArrow1" value="Tablet 재분배&#10;(수 시간)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#b85450;strokeWidth=2;dashed=1;fontColor=#b85450;" parent="scBePanel" source="scBe1" target="scBe3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="105" y="250"/>
                            <mxPoint x="465" y="250"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="scBeArrow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" parent="scBePanel" source="scBe2" target="scBe3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="285" y="240"/>
                            <mxPoint x="465" y="240"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="scBeNote" value="노드 추가는 되지만…&lt;br&gt;• 기존 노드의 데이터(Tablet)를 새 노드로 옮기는 재분배 필요 → 수 시간 + 네트워크/디스크 부하&lt;br&gt;• 저장·연산이 묶여 확장 — 연산만/저장만 따로 못 늘림&lt;br&gt;• 축소(scale-in)는 더 부담 — 나가는 노드의 데이터를 전부 빼내야 함&lt;br&gt;→ 처음부터 노드 수·디스크를 여유 있게 설계 권장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;" parent="scBePanel" vertex="1">
                    <mxGeometry x="30" y="320" width="510" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="scCnPanel" value="CN (Shared-Data) — 가로 확장 ✅ 즉각적·탄력적" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontSize=14;fontStyle=1;container=1;collapsible=0;" parent="1" vertex="1">
                    <mxGeometry x="650" y="90" width="560" height="480" as="geometry"/>
                </mxCell>
                <mxCell id="scCn1" value="CN 1&lt;br&gt;무상태&lt;br&gt;(캐시만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" parent="scCnPanel" vertex="1">
                    <mxGeometry x="30" y="60" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="scCn2" value="CN 2&lt;br&gt;무상태&lt;br&gt;(캐시만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" parent="scCnPanel" vertex="1">
                    <mxGeometry x="210" y="60" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="scCn3" value="CN 3 (신규)&lt;br&gt;몇 초~몇 분 내 투입&lt;br&gt;옮길 데이터 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;dashed=1;" parent="scCnPanel" vertex="1">
                    <mxGeometry x="390" y="60" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="scS3" value="오브젝트 스토리지 (S3 / MinIO ...) — 데이터 단일 사본, 그대로 있음 (사실상 무한 확장)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=15;" parent="scCnPanel" vertex="1">
                    <mxGeometry x="90" y="200" width="390" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="scCnArrow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;" parent="scCnPanel" source="scCn1" target="scS3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="scCnArrow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;" parent="scCnPanel" source="scCn2" target="scS3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="scCnArrow3" value="캐시 워밍만" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;dashed=1;fontSize=11;" parent="scCnPanel" source="scCn3" target="scS3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="scCnNote" value="데이터가 전부 S3에 있어 노드가 무상태 →&lt;br&gt;• 노드 추가 시 옮길 데이터 없음 — 캐시만 다시 데워지면 끝 (auto-scaling 실용적)&lt;br&gt;• 저장(S3)과 연산(CN)을 독립적으로 따로 확장&lt;br&gt;• 축소는 그냥 종료하면 됨&lt;br&gt;⚠️ 단, 벡터 인덱스 미지원 — 임베딩 검색이면 이 모드 선택 불가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;" parent="scCnPanel" vertex="1">
                    <mxGeometry x="30" y="320" width="510" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="scTable" value="&lt;b&gt;정리&lt;/b&gt;&lt;br&gt;&lt;br&gt;세로 확장(사양↑) — BE ✅ / CN ✅&lt;br&gt;가로 확장(노드 추가) — BE ✅ 데이터 재분배 필요(느리고 무거움) / CN ✅ 데이터 이동 없음(초 단위, 탄력적)&lt;br&gt;저장·연산 독립 확장 — BE ❌ 항상 같이 늘어남 / CN ✅ 각각 따로&lt;br&gt;축소(scale-in) — BE 부담 큼(데이터 빼내야 함) / CN 쉬움(그냥 종료)&lt;br&gt;벡터 인덱스 — BE ✅ / CN ❌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=15;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="610" width="1170" height="170" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
